# Copia este ficheiro para ".env" e coloca a tua chave da Groq
# (cria uma em https://console.groq.com/keys)
GROQ_API_KEY=coloca_aqui_a_tua_chave

# Opcional: modelo usado para responder (por defeito, o primeiro disponível
# de: openai/gpt-oss-120b, llama-3.3-70b-versatile, qwen/qwen3.8-27b)
# GROQ_MODELO=openai/gpt-oss-120b
